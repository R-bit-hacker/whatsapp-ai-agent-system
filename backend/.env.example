# ==============================================================
# WhatsApp AI Agent Management System - Environment Variables
# ==============================================================

# Database
DATABASE_URL=sqlite:///./whatsapp_system.db

# LLM Configuration (OpenAI or Groq)
# If your key starts with 'gsk_' (Groq), base_url="https://api.groq.com/openai/v1" is automatically configured.
OPENAI_API_KEY=gsk_your_groq_api_key_or_sk_openai_key
OPENAI_MODEL=llama-3.3-70b-versatile

# WhatsApp Cloud API (Meta Developers)
WHATSAPP_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=my_secure_verify_token
